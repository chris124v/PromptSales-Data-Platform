# Template of the environment variables for PromptSales-Data-Platform
# Copy this file as .env in the repository root and fill in your own values.
# The .env file is ignored by Git: never commit it.

# Database passwords
# Used by kubernetes/scripts/deploy-all.ps1 (Kubernetes secrets) and mcp-server/config/databases.yaml
POSTGRES_PASSWORD=your_postgres_password
MONGO_PASSWORD=your_mongo_password
# SQL Server requires at least 8 characters with uppercase, lowercase, numbers, and symbols
MSSQL_SA_PASSWORD=your_sqlserver_password
REDIS_PASSWORD=your_redis_password

# MongoDB connection string used by the PromptContent scripts
MONGO_URL=mongodb://mongouser:${MONGO_PASSWORD}@localhost:30017/promptcontent?authSource=admin

# AI services (MCP server and PromptContent scripts)
PINECONE_API_KEY=your_pinecone_api_key
GROQ_API_KEY=your_groq_api_key
AI_PROVIDER=groq

# Absolute path of this repository (the MCP server uses it to import the PromptContent tools)
PROJECT_ROOT=C:\path\to\PromptSales-Data-Platform
